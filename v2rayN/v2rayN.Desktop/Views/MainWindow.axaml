<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:conv="clr-namespace:v2rayN.Desktop.Converters"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="喵喵"
    Width="1240"
    Height="800"
    MinWidth="920"
    MinHeight="620"
    x:DataType="vms:MainWindowViewModel"
    Classes="MiaomiaoWindow"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    Icon="/Assets/v2rayN.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <conv:MiaomiaoDateConverter x:Key="MiaomiaoDateConverter" />
        <conv:MiaomiaoRemainingBytesConverter x:Key="MiaomiaoRemainingBytesConverter" />
        <conv:MiaomiaoProxyStateTextConverter x:Key="MiaomiaoProxyStateTextConverter" />
    </Window.Resources>
    <dialogHost:DialogHost CloseOnClickAway="True" DisableOpeningAnimation="True">
        <Grid ColumnDefinitions="188,*">
            <Border Grid.Column="0" Classes="MiaomiaoSidebar">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Margin="22,24,18,26" Spacing="2">
                            <TextBlock
                                FontSize="19"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource MiaomiaoSidebarForegroundBrush}"
                                Text="喵喵" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource MiaomiaoNavForegroundBrush}"
                                Text="MIAOMIAO" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button
                            x:Name="navHome"
                            Classes="MiaomiaoNav Active"
                            Click="NavHome_Click"
                            ToolTip.Tip="首页">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon
                                    Width="18"
                                    Height="18"
                                    Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20Z"
                                    Foreground="{Binding Foreground, ElementName=navHome}" />
                                <TextBlock VerticalAlignment="Center" Text="首页" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="navPlans"
                            Classes="MiaomiaoNav"
                            Click="NavPlans_Click"
                            ToolTip.Tip="套餐">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon
                                    Width="18"
                                    Height="18"
                                    Data="M4,3H20A2,2 0 0,1 22,5V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V5A2,2 0 0,1 4,3M4,7V19H20V7H4M6,9H13V11H6V9M6,13H18V15H6V13Z"
                                    Foreground="{Binding Foreground, ElementName=navPlans}" />
                                <TextBlock VerticalAlignment="Center" Text="套餐" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="navOrders"
                            Classes="MiaomiaoNav"
                            Click="NavOrders_Click"
                            ToolTip.Tip="订单">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon
                                    Width="18"
                                    Height="18"
                                    Data="M7,2H17A2,2 0 0,1 19,4V22L16,20L14,22L12,20L10,22L8,20L5,22V4A2,2 0 0,1 7,2M8,6V8H16V6H8M8,10V12H16V10H8M8,14V16H13V14H8Z"
                                    Foreground="{Binding Foreground, ElementName=navOrders}" />
                                <TextBlock VerticalAlignment="Center" Text="订单" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="navTools"
                            Classes="MiaomiaoNav"
                            Click="NavTools_Click"
                            ToolTip.Tip="设置">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon
                                    Width="18"
                                    Height="18"
                                    Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37L19.54,5.91L17.05,6.91C16.54,6.52 15.98,6.19 15.37,5.95L15,3.27H11L10.63,5.95C10.02,6.19 9.46,6.52 8.95,6.91L6.46,5.91L4.46,9.37L6.57,11.02C6.53,11.34 6.5,11.67 6.5,12C6.5,12.33 6.53,12.66 6.57,12.98L4.46,14.63L6.46,18.09L8.95,17.09C9.46,17.48 10.02,17.81 10.63,18.05L11,20.73H15L15.37,18.05C15.98,17.81 16.54,17.48 17.05,17.09L19.54,18.09L21.54,14.63L19.43,12.98M13,15.5C11.07,15.5 9.5,13.93 9.5,12C9.5,10.07 11.07,8.5 13,8.5C14.93,8.5 16.5,10.07 16.5,12C16.5,13.93 14.93,15.5 13,15.5Z"
                                    Foreground="{Binding Foreground, ElementName=navTools}" />
                                <TextBlock VerticalAlignment="Center" Text="设置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="18,16" Spacing="8">
                        <ContentControl x:Name="conTheme" HorizontalAlignment="Left" />
                        <TextBlock
                            x:Name="txtVersion"
                            FontSize="11"
                            Foreground="{DynamicResource MiaomiaoNavForegroundBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="pageHome" RowDefinitions="Auto,*">
                    <Border
                        Grid.Row="0"
                        Padding="24,16"
                        Background="{DynamicResource MiaomiaoSurfaceBrush}"
                        BorderBrush="{DynamicResource MiaomiaoBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="MiaomiaoPageTitle" Text="首页" />
                                <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="连接、线路与账户状态" />
                            </StackPanel>
                            <Button x:Name="btnHomeRefresh" Grid.Column="1" Classes="MiaomiaoSecondary" ToolTip.Tip="立即更新托管订阅">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" />
                                    <TextBlock VerticalAlignment="Center" Text="更新订阅" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="22" ColumnDefinitions="1.15*,0.85*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="18">
                            <Border Grid.Row="0" Grid.Column="0" Padding="28" Classes="MiaomiaoCard">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
                                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                                        <TextBlock HorizontalAlignment="Center" Classes="MiaomiaoMuted" Text="当前线路" />
                                        <TextBlock
                                            MaxWidth="500"
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding StatusBarViewModel.RunningServerDisplay, FallbackValue=请选择线路, TargetNullValue=请选择线路}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        x:Name="btnConnectionToggle"
                                        Grid.Row="1"
                                        Width="174"
                                        Height="174"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Classes="MiaomiaoConnect"
                                        Click="ConnectionToggle_Click">
                                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                                            <PathIcon
                                                Width="34"
                                                Height="34"
                                                HorizontalAlignment="Center"
                                                Data="M13,3H11V13H13V3M17.83,5.17L16.41,6.59C17.99,7.86 19,9.81 19,12A7,7 0 0,1 12,19A7,7 0 0,1 5,12C5,9.81 6.01,7.86 7.59,6.59L6.17,5.17C4.23,6.82 3,9.26 3,12A9,9 0 0,0 12,21A9,9 0 0,0 21,12C21,9.26 19.77,6.82 17.83,5.17Z" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="{Binding StatusBarViewModel.SystemProxySelected, Converter={StaticResource MiaomiaoProxyStateTextConverter}}"
                                                TextAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock VerticalAlignment="Center" Classes="MiaomiaoMuted" Text="TUN 模式" />
                                            <ToggleSwitch IsChecked="{Binding StatusBarViewModel.EnableTun, Mode=TwoWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Classes="MiaomiaoMuted"
                                            FontSize="12"
                                            Text="{Binding StatusBarViewModel.InboundDisplay}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="homeAccountPanel"
                                Grid.Row="0"
                                Grid.Column="1"
                                Padding="22"
                                Classes="MiaomiaoCard"
                                x:DataType="vms:MiaomiaoAccountViewModel">
                                <Grid>
                                    <StackPanel IsVisible="{Binding !IsLoggedIn}" VerticalAlignment="Center" Spacing="12">
                                        <TextBlock Classes="MiaomiaoSectionTitle" Text="账户" />
                                        <TextBlock Classes="MiaomiaoMuted" Text="登录后查看剩余流量、到期时间和套餐。" TextWrapping="Wrap" />
                                        <Button HorizontalAlignment="Left" Classes="MiaomiaoPrimary" Click="OpenPlans_Click" Content="登录账户" />
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding IsLoggedIn}" Spacing="16">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="MiaomiaoSectionTitle" Text="{Binding CurrentSubscription.Plan.Name, FallbackValue=当前套餐, TargetNullValue=当前套餐}" />
                                                <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="{Binding CurrentUser.Email}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="MiaomiaoSecondary" Click="OpenPlans_Click" Content="管理" />
                                        </Grid>
                                        <Border Padding="14" Classes="MiaomiaoSoftCard">
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Classes="MiaomiaoMuted" FontSize="11" Text="剩余流量" />
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding CurrentSubscription, Converter={StaticResource MiaomiaoRemainingBytesConverter}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Classes="MiaomiaoMuted" FontSize="11" Text="设备数" />
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding CurrentSubscription.DeviceLimit, FallbackValue=-, TargetNullValue=-}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="3">
                                                    <TextBlock Classes="MiaomiaoMuted" FontSize="11" Text="到期时间" />
                                                    <TextBlock Text="{Binding CurrentSubscription.ExpiredAt, Converter={StaticResource MiaomiaoDateConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="托管订阅每 48 小时自动更新" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="20" Classes="MiaomiaoCard">
                                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="MiaomiaoSectionTitle" Text="切换线路" />
                                            <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="选择线路后立即应用" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="MiaomiaoSecondary" Click="OpenAllRoutes_Click" Content="全部线路" />
                                    </Grid>
                                    <ListBox
                                        Grid.Row="1"
                                        MaxHeight="170"
                                        Classes="MiaomiaoRouteList"
                                        ItemsSource="{Binding StatusBarViewModel.Servers}"
                                        SelectedItem="{Binding StatusBarViewModel.SelectedServer, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ComboItem">
                                                <Grid MinHeight="42" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <Border Width="8" Height="8" VerticalAlignment="Center" Background="{DynamicResource MiaomiaoPrimaryBrush}" CornerRadius="4" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="pageConnection" IsVisible="False" RowDefinitions="Auto,Auto,*">
                    <Border
                        Grid.Row="0"
                        Padding="24,16"
                        Background="{DynamicResource MiaomiaoSurfaceBrush}"
                        BorderBrush="{DynamicResource MiaomiaoBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="MiaomiaoPageTitle" Text="全部线路" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="btnQuickRefresh"
                                    Classes="MiaomiaoSecondary"
                                    ToolTip.Tip="立即更新订阅">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon
                                            Width="16"
                                            Height="16"
                                            Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                            Foreground="{Binding Foreground, ElementName=btnQuickRefresh}" />
                                        <TextBlock VerticalAlignment="Center" Text="更新订阅" />
                                    </StackPanel>
                                </Button>
                                <Menu>
                                    <MenuItem Header="更多">
                                        <MenuItem Header="节点">
                                            <MenuItem x:Name="menuAddServerViaClipboard" Header="{x:Static resx:ResUI.menuAddServerViaClipboard}" InputGesture="Ctrl+V" />
                                            <MenuItem x:Name="menuAddServerViaScan" Header="{x:Static resx:ResUI.menuAddServerViaScan}" InputGesture="Ctrl+S" />
                                            <MenuItem x:Name="menuAddServerViaImage" Header="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                            <MenuItem x:Name="menuAddCustomServer" Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                            <MenuItem x:Name="menuAddPolicyGroupServer" Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                            <MenuItem x:Name="menuAddProxyChainServer" Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                            <Separator />
                                            <MenuItem x:Name="menuAddVmessServer" Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                            <MenuItem x:Name="menuAddVlessServer" Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                            <MenuItem x:Name="menuAddShadowsocksServer" Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                            <MenuItem x:Name="menuAddTrojanServer" Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                            <MenuItem x:Name="menuAddHysteria2Server" Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                            <MenuItem x:Name="menuAddWireguardServer" Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                            <MenuItem x:Name="menuAddSocksServer" Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                            <MenuItem x:Name="menuAddHttpServer" Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                            <MenuItem x:Name="menuAddTuicServer" Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                            <MenuItem x:Name="menuAddAnytlsServer" Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                            <MenuItem x:Name="menuAddNaiveServer" Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                                        </MenuItem>
                                        <MenuItem Header="订阅">
                                            <MenuItem x:Name="menuSubSetting" Header="{x:Static resx:ResUI.menuSubSetting}" />
                                            <Separator />
                                            <MenuItem x:Name="menuSubUpdate" Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                            <MenuItem x:Name="menuSubUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                            <MenuItem x:Name="menuSubGroupUpdate" Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                            <MenuItem x:Name="menuSubGroupUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                                        </MenuItem>
                                        <MenuItem Header="设置">
                                            <MenuItem x:Name="menuOptionSetting" Header="{x:Static resx:ResUI.menuOptionSetting}" />
                                            <MenuItem x:Name="menuRoutingSetting" Header="{x:Static resx:ResUI.menuRoutingSetting}" />
                                            <MenuItem x:Name="menuDNSSetting" Header="{x:Static resx:ResUI.menuDNSSetting}" />
                                            <MenuItem x:Name="menuFullConfigTemplate" Header="{x:Static resx:ResUI.menuFullConfigTemplate}" />
                                            <MenuItem x:Name="menuGlobalHotkeySetting" Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}" IsVisible="{Binding BlIsWindows}" />
                                            <Separator />
                                            <MenuItem x:Name="menuRebootAsAdmin" Header="{x:Static resx:ResUI.menuRebootAsAdmin}" IsVisible="{Binding BlIsWindows}" />
                                            <MenuItem x:Name="menuClearServerStatistics" Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                                            <MenuItem Header="{x:Static resx:ResUI.menuRegionalPresets}">
                                                <MenuItem x:Name="menuRegionalPresetsDefault" Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}" />
                                                <MenuItem x:Name="menuRegionalPresetsRussia" Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}" />
                                                <MenuItem x:Name="menuRegionalPresetsIran" Header="{x:Static resx:ResUI.menuRegionalPresetsIran}" />
                                            </MenuItem>
                                            <MenuItem x:Name="menuBackupAndRestore" Header="{x:Static resx:ResUI.menuBackupAndRestore}" />
                                            <MenuItem x:Name="menuOpenTheFileLocation" Header="{x:Static resx:ResUI.menuOpenTheFileLocation}" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem x:Name="menuReload" Header="{x:Static resx:ResUI.menuReload}" />
                                        <MenuItem x:Name="menuClose" Header="{x:Static resx:ResUI.menuExit}" />
                                    </MenuItem>
                                </Menu>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="20,18,20,12" Classes="MiaomiaoCard">
                        <ContentControl x:Name="contentStatusBarView" />
                    </Border>

                    <Border Grid.Row="2" Margin="20,0,20,20" Padding="8" Classes="MiaomiaoCard">
                        <Grid>
                            <Grid x:Name="gridMain" ColumnDefinitions="1*,8,1*" IsVisible="False">
                                <ContentControl x:Name="tabProfiles" Grid.Column="0" />
                                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                                <TabControl x:Name="tabMain" Grid.Column="2" HorizontalContentAlignment="Left">
                                    <TabItem x:Name="tabMsgView" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                                    <TabItem x:Name="tabClashProxies" Header="{x:Static resx:ResUI.TbProxies}" />
                                    <TabItem x:Name="tabClashConnections" Header="{x:Static resx:ResUI.TbConnections}" />
                                </TabControl>
                            </Grid>
                            <Grid x:Name="gridMain1" RowDefinitions="1*,8,1*" IsVisible="False">
                                <ContentControl x:Name="tabProfiles1" Grid.Row="0" />
                                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
                                <TabControl x:Name="tabMain1" Grid.Row="2" TabStripPlacement="Left">
                                    <TabItem x:Name="tabMsgView1" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                                    <TabItem x:Name="tabClashProxies1" Header="{x:Static resx:ResUI.TbProxies}" />
                                    <TabItem x:Name="tabClashConnections1" Header="{x:Static resx:ResUI.TbConnections}" />
                                </TabControl>
                            </Grid>
                            <Grid x:Name="gridMain2" IsVisible="False">
                                <TabControl x:Name="tabMain2" TabStripPlacement="Left">
                                    <TabItem x:Name="tabProfiles2" Header="{x:Static resx:ResUI.menuServers}" />
                                    <TabItem x:Name="tabMsgView2" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                                    <TabItem x:Name="tabClashProxies2" Header="{x:Static resx:ResUI.TbProxies}" />
                                    <TabItem x:Name="tabClashConnections2" Header="{x:Static resx:ResUI.TbConnections}" />
                                </TabControl>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="pageAccount" IsVisible="False" RowDefinitions="Auto,*">
                    <Border
                        Grid.Row="0"
                        Padding="24,16"
                        Background="{DynamicResource MiaomiaoSurfaceBrush}"
                        BorderBrush="{DynamicResource MiaomiaoBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="txtAccountPageTitle" Classes="MiaomiaoPageTitle" Text="套餐" />
                        </StackPanel>
                    </Border>
                    <ContentControl x:Name="contentAccount" Grid.Row="1" Margin="20" />
                </Grid>

                <Grid x:Name="pageTools" IsVisible="False" RowDefinitions="Auto,*">
                    <Border
                        Grid.Row="0"
                        Padding="24,16"
                        Background="{DynamicResource MiaomiaoSurfaceBrush}"
                        BorderBrush="{DynamicResource MiaomiaoBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="MiaomiaoPageTitle" Text="设置" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <WrapPanel Margin="20" ItemWidth="250" ItemHeight="72">
                            <Button x:Name="btnOptions" Margin="0,0,12,12" Classes="MiaomiaoSecondary">
                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="12">
                                    <Border Width="34" Height="34" Background="{DynamicResource MiaomiaoPrimarySoftBrush}" CornerRadius="6">
                                        <PathIcon
                                            Width="17"
                                            Height="17"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
