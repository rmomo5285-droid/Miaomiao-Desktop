                    <TextBlock x:Name="txtVersion" IsVisible="False" />
                    <Border Grid.Column="1" Width="42" Height="42" VerticalAlignment="Center" Classes="MiaomiaoBottomUtility">
                        <ContentControl x:Name="conTheme" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </dialogHost:DialogHost>
</Window>
