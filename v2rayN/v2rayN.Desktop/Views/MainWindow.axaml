<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:conv="clr-namespace:v2rayN.Desktop.Converters"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="喵喵"
    Width="1280"
    Height="820"
    MinWidth="960"
    MinHeight="640"
    x:DataType="vms:MainWindowViewModel"
    Classes="MiaomiaoWindow"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    Icon="/Assets/v2rayN.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <conv:MiaomiaoDateConverter x:Key="MiaomiaoDateConverter" />
        <conv:MiaomiaoDelayDisplayConverter x:Key="MiaomiaoDelayDisplayConverter" />
        <conv:MiaomiaoRemainingBytesConverter x:Key="MiaomiaoRemainingBytesConverter" />
        <conv:MiaomiaoTrafficUsageConverter x:Key="MiaomiaoTrafficUsageConverter" />
        <conv:MiaomiaoUsageProgressConverter x:Key="MiaomiaoUsageProgressConverter" />
        <conv:MiaomiaoExpirySummaryConverter x:Key="MiaomiaoExpirySummaryConverter" />
        <conv:MiaomiaoProxyStateTextConverter x:Key="MiaomiaoProxyStateTextConverter" />
        <conv:MiaomiaoSpeedDisplayConverter x:Key="MiaomiaoSpeedDisplayConverter" />
    </Window.Resources>

    <dialogHost:DialogHost CloseOnClickAway="True" DisableOpeningAnimation="True">
        <Grid RowDefinitions="*,78">
            <Grid Grid.Row="0">
                <Grid x:Name="pageHome">
                    <Grid Margin="28,20,28,20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
                        <Border
                            x:Name="homeAccountPanel"
                            Grid.Row="0"
                            Padding="18,14"
                            Classes="MiaomiaoUsageStrip"
                            x:DataType="vms:MiaomiaoAccountViewModel">
                            <Grid>
                                <Grid IsVisible="{Binding IsLoggedIn}" ColumnDefinitions="0.7*,0.7*,1.5*,Auto,Auto" ColumnSpacing="22">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Classes="MiaomiaoMuted" Text="剩余流量" />
                                        <TextBlock Classes="MiaomiaoUsageValue" Text="{Binding CurrentSubscription, Converter={StaticResource MiaomiaoRemainingBytesConverter}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Classes="MiaomiaoMuted" Text="有效期" />
                                        <TextBlock Classes="MiaomiaoUsageValue Warning" Text="{Binding CurrentSubscription.ExpiredAt, Converter={StaticResource MiaomiaoExpirySummaryConverter}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="7">
                                        <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding CurrentSubscription, Converter={StaticResource MiaomiaoUsageProgressConverter}}" />
                                        <TextBlock Classes="MiaomiaoMuted" Text="{Binding CurrentSubscription, Converter={StaticResource MiaomiaoTrafficUsageConverter}}" />
                                    </StackPanel>
                                    <Button x:Name="btnHomeRefresh" Grid.Column="3" Classes="MiaomiaoSquareAction" ToolTip.Tip="立即更新订阅">
                                        <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" />
                                    </Button>
                                    <Button Grid.Column="4" Classes="MiaomiaoNoticeAction" Click="OpenNotices_Click" ToolTip.Tip="查看公告">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="M20,11V7L4,7V11A2,2 0 0,0 2,13A2,2 0 0,0 4,15V19H5L7,15H13L15,19H17L15,15H20V11M18,13H6V9H18V13Z" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Notices.Count}" />
                                            <TextBlock VerticalAlignment="Center" Text="条公告" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid IsVisible="{Binding !IsLoggedIn}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="登录账户后显示套餐流量与到期时间" />
                                        <TextBlock Classes="MiaomiaoMuted" Text="本机已有线路仍可继续使用" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="MiaomiaoSecondary" Click="OpenPlans_Click" Content="查看套餐" />
                                    <Button Grid.Column="2" Classes="MiaomiaoPrimary" Click="OpenAccount_Click" Content="登录账户" />
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                            <Grid Width="190" Height="190">
                                <Border Margin="8" BorderBrush="{DynamicResource MiaomiaoPowerHaloOuterBrush}" BorderThickness="1" CornerRadius="92" />
                                <Border Margin="20" BorderBrush="{DynamicResource MiaomiaoPowerHaloInnerBrush}" BorderThickness="9" CornerRadius="78" />
                                <Button
                                    x:Name="btnConnectionToggle"
                                    Width="150"
                                    Height="150"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Classes="MiaomiaoConnect"
                                    Click="ConnectionToggle_Click">
                                    <PathIcon
                                        Width="52"
                                        Height="52"
                                        Data="M13,3H11V13H13V3M17.83,5.17L16.41,6.59C17.99,7.86 19,9.81 19,12A7,7 0 0,1 12,19A7,7 0 0,1 5,12C5,9.81 6.01,7.86 7.59,6.59L6.17,5.17C4.23,6.82 3,9.26 3,12A9,9 0 0,0 12,21A9,9 0 0,0 21,12C21,9.26 19.77,6.82 17.83,5.17Z" />
                                </Button>
                            </Grid>
                            <Border Padding="15,7" Classes="MiaomiaoConnectionState">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{Binding StatusBarViewModel.SystemProxySelected, Converter={StaticResource MiaomiaoProxyStateTextConverter}}"
                                    TextAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Width="780" MaxWidth="780" HorizontalAlignment="Center" Spacing="10">
                            <Border Padding="14" Classes="MiaomiaoModeBar">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="代理模式" />
                                        <TextBlock Classes="MiaomiaoMuted" Text="选择分流规则与 TUN" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        MinWidth="250"
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberBinding="{Binding Remarks}"
                                        ItemsSource="{Binding StatusBarViewModel.RoutingItems}"
                                        SelectedItem="{Binding StatusBarViewModel.SelectedRouting, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="MiaomiaoMuted" Text="TUN" />
                                    <ToggleSwitch Grid.Column="3" VerticalAlignment="Center" IsChecked="{Binding StatusBarViewModel.EnableTun, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Button Classes="MiaomiaoNodePicker" Click="OpenAllRoutes_Click">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="13">
                                    <Border Width="38" Height="38" Classes="MiaomiaoIconSurface">
                                        <PathIcon Data="M12,3A4,4 0 0,0 8,7C8,9.4 12,14 12,14C12,14 16,9.4 16,7A4,4 0 0,0 12,3M12,5A2,2 0 1,1 12,9A2,2 0 0,1 12,5M5,19V21H19V19H5Z" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding ProfilesViewModel.SelectedProfile.Remarks, FallbackValue=请选择线路, TargetNullValue=请选择线路}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="MiaomiaoMuted" Text="当前线路" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="MiaomiaoRouteMetric" Text="{Binding ProfilesViewModel.SelectedProfile.DelayVal, Converter={StaticResource MiaomiaoDelayDisplayConverter}}" />
                                    <PathIcon Grid.Column="3" VerticalAlignment="Center" Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="pageConnection" IsVisible="False" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="MiaomiaoPageHeader">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="MiaomiaoPageTitle" Text="选择线路" />
                                <TextBlock Classes="MiaomiaoMuted" Text="点击任意线路立即切换" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="4" Classes="MiaomiaoActionDock">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="MiaomiaoDiagnostic" Command="{Binding ProfilesViewModel.FastRealPingCmd}" ToolTip.Tip="检测全部线路的连通性与真实延迟">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M3,12H7L10,4L14,20L17,12H21" />
                                        <TextBlock VerticalAlignment="Center" Text="连通性检测" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="MiaomiaoDiagnostic Accent" Command="{Binding ProfilesViewModel.MixedTestServerCmd}" ToolTip.Tip="测试全部线路的延迟与速度">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M12,4A8,8 0 0,0 4,12C4,14.21 4.9,16.21 6.34,17.66L7.76,16.24C6.68,15.15 6,13.65 6,12A6,6 0 0,1 18,12C18,13.65 17.32,15.15 16.24,16.24L17.66,17.66C19.1,16.21 20,14.21 20,12A8,8 0 0,0 12,4M15.5,8.5L11,11V13L12.5,14.5L15.5,8.5Z" />
                                        <TextBlock VerticalAlignment="Center" Text="线路测速" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnQuickRefresh" Classes="MiaomiaoDiagnostic" ToolTip.Tip="立即更新订阅">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" />
                                        <TextBlock VerticalAlignment="Center" Text="更新订阅" />
                                    </StackPanel>
                                </Button>
                                <Menu Classes="MiaomiaoHeaderMenu">
                                    <MenuItem Header="高级">
                                        <MenuItem Header="节点管理">
                                            <MenuItem x:Name="menuAddServerViaClipboard" Header="{x:Static resx:ResUI.menuAddServerViaClipboard}" InputGesture="Ctrl+V" />
                                            <MenuItem x:Name="menuAddServerViaScan" Header="{x:Static resx:ResUI.menuAddServerViaScan}" InputGesture="Ctrl+S" />
                                            <MenuItem x:Name="menuAddServerViaImage" Header="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                            <MenuItem x:Name="menuAddCustomServer" Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                            <MenuItem x:Name="menuAddPolicyGroupServer" Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                            <MenuItem x:Name="menuAddProxyChainServer" Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                            <Separator />
                                            <MenuItem x:Name="menuAddVmessServer" Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                            <MenuItem x:Name="menuAddVlessServer" Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                            <MenuItem x:Name="menuAddShadowsocksServer" Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                            <MenuItem x:Name="menuAddTrojanServer" Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                            <MenuItem x:Name="menuAddHysteria2Server" Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                            <MenuItem x:Name="menuAddWireguardServer" Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                            <MenuItem x:Name="menuAddSocksServer" Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                            <MenuItem x:Name="menuAddHttpServer" Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                            <MenuItem x:Name="menuAddTuicServer" Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                            <MenuItem x:Name="menuAddAnytlsServer" Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                            <MenuItem x:Name="menuAddNaiveServer" Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                                        </MenuItem>
                                        <MenuItem Header="订阅管理">
                                            <MenuItem x:Name="menuSubSetting" Header="{x:Static resx:ResUI.menuSubSetting}" />
                                            <Separator />
                                            <MenuItem x:Name="menuSubUpdate" Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                            <MenuItem x:Name="menuSubUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                            <MenuItem x:Name="menuSubGroupUpdate" Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                            <MenuItem x:Name="menuSubGroupUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem x:Name="menuReload" Header="{x:Static resx:ResUI.menuReload}" />
                                        <MenuItem x:Name="menuClose" Header="{x:Static resx:ResUI.menuExit}" />
                                    </MenuItem>
                                </Menu>
                            </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="28,24,28,28" RowDefinitions="Auto,Auto" RowSpacing="18">
                            <Border Grid.Row="0" Padding="18,16" Classes="MiaomiaoSelectedRoute">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Width="38" Height="38" Classes="MiaomiaoIconSurface">
                                        <PathIcon Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Classes="MiaomiaoEyebrow" Text="当前线路" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding ProfilesViewModel.SelectedProfile.Remarks, FallbackValue=请选择线路, TargetNullValue=请选择线路}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="MiaomiaoRouteMetric" Text="{Binding ProfilesViewModel.SelectedProfile.DelayVal, Converter={StaticResource MiaomiaoDelayDisplayConverter}}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" Classes="MiaomiaoMuted" Text="TUN" />
                                        <ToggleSwitch IsChecked="{Binding StatusBarViewModel.EnableTun, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ListBox
                                Grid.Row="1"
                                Classes="MiaomiaoRouteGallery"
                                ItemsSource="{Binding ProfilesViewModel.ProfileItems}"
                                SelectedItem="{Binding ProfilesViewModel.SelectedProfile, Mode=TwoWay}"
                                SelectionChanged="MiaomiaoRoutes_SelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProfileItemModel">
                                        <Grid MinHeight="68" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <Border Width="36" Height="36" VerticalAlignment="Center" Classes="MiaomiaoRouteIcon">
                                                <PathIcon Data="M12,2C8.14,2 5,5.14 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9C19,5.14 15.86,2 12,2M12,11.5A2.5,2.5 0 1,1 12,6.5A2.5,2.5 0 0,1 12,11.5Z" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Remarks}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="MiaomiaoMuted" Text="{Binding SpeedVal, Converter={StaticResource MiaomiaoSpeedDisplayConverter}}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="MiaomiaoRouteMetric" Text="{Binding DelayVal, Converter={StaticResource MiaomiaoDelayDisplayConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="pageAccount" IsVisible="False" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="MiaomiaoPageHeader">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="txtAccountPageTitle" Classes="MiaomiaoPageTitle" Text="账户" />
                            <TextBlock Classes="MiaomiaoMuted" Text="账户、套餐、订单与公告" />
                        </StackPanel>
                    </Border>
                    <ContentControl x:Name="contentAccount" Grid.Row="1" Margin="28,22,28,28" />
                </Grid>

                <Grid x:Name="pageTools" IsVisible="False" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="MiaomiaoPageHeader">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="MiaomiaoPageTitle" Text="设置" />
                            <TextBlock Classes="MiaomiaoMuted" Text="网络与应用管理" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="28,24,28,30" ColumnDefinitions="1.08*,0.92*" ColumnSpacing="18">
                            <StackPanel Grid.Column="0" Spacing="10">
                                <StackPanel Margin="4,0,0,2" Spacing="3">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="网络配置" />
                                    <TextBlock Classes="MiaomiaoMuted" Text="代理核心、路由与订阅行为" />
                                </StackPanel>
                                <Border Classes="MiaomiaoSettingsGroup">
                                    <StackPanel Spacing="2">
                                        <Button x:Name="btnOptions" Classes="MiaomiaoSettingsRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <Border Classes="MiaomiaoSettingsIcon"><PathIcon Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37L19.54,5.91L17.05,6.91C16.54,6.52 15.98,6.19 15.37,5.95L15,3.27H11L10.63,5.95C10.02,6.19 9.46,6.52 8.95,6.91L6.46,5.91L4.46,9.37L6.57,11.02C6.53,11.34 6.5,11.67 6.5,12C6.5,12.33 6.53,12.66 6.57,12.98L4.46,14.63L6.46,18.09L8.95,17.09C9.46,17.48 10.02,17.81 10.63,18.05L11,20.73H15L15.37,18.05C15.98,17.81 16.54,17.48 17.05,17.09L19.54,18.09L21.54,14.63L19.43,12.98M13,15.5C11.07,15.5 9.5,13.93 9.5,12C9.5,10.07 11.07,8.5 13,8.5C14.93,8.5 16.5,10.07 16.5,12C16.5,13.93 14.93,15.5 13,15.5Z" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="基础设置" /><TextBlock Classes="MiaomiaoMuted" Text="代理、端口、核心与系统行为" /></StackPanel>
                                                <PathIcon Grid.Column="2" VerticalAlignment="Center" Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="btnRouting" Classes="MiaomiaoSettingsRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <Border Classes="MiaomiaoSettingsIcon"><PathIcon Data="M6,3A3,3 0 0,0 3,6C3,7.31 3.84,8.42 5,8.83V15.17C3.84,15.58 3,16.69 3,18A3,3 0 0,0 6,21A3,3 0 0,0 9,18C9,16.69 8.16,15.58 7,15.17V9H15V11.17C13.84,11.58 13,12.69 13,14A3,3 0 0,0 16,17A3,3 0 0,0 19,14C19,12.69 18.16,11.58 17,11.17V7H7V8.83C8.16,8.42 9,7.31 9,6A3,3 0 0,0 6,3Z" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="路由规则" /><TextBlock Classes="MiaomiaoMuted" Text="分流模式与规则集" /></StackPanel>
                                                <PathIcon Grid.Column="2" VerticalAlignment="Center" Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="btnDns" Classes="MiaomiaoSettingsRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <Border Classes="MiaomiaoSettingsIcon"><PathIcon Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M19.93,11H16.95C16.75,8.53 15.98,6.2 14.74,4.5A8.03,8.03 0 0,1 19.93,11M12,4C13.38,5.67 14.21,8.05 14.45,11H9.55C9.79,8.05 10.62,5.67 12,4M4.07,13H7.05C7.25,15.47 8.02,17.8 9.26,19.5A8.03,8.03 0 0,1 4.07,13M7.05,11H4.07A8.03,8.03 0 0,1 9.26,4.5C8.02,6.2 7.25,8.53 7.05,11M12,20C10.62,18.33 9.79,15.95 9.55,13H14.45C14.21,15.95 13.38,18.33 12,20M14.74,19.5C15.98,17.8 16.75,15.47 16.95,13H19.93A8.03,8.03 0 0,1 14.74,19.5Z" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="DNS" /><TextBlock Classes="MiaomiaoMuted" Text="域名解析与防泄漏设置" /></StackPanel>
                                                <PathIcon Grid.Column="2" VerticalAlignment="Center" Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="btnSubscriptionSetting" Classes="MiaomiaoSettingsRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <Border Classes="MiaomiaoSettingsIcon"><PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="订阅管理" /><TextBlock Classes="MiaomiaoMuted" Text="托管订阅每 48 小时自动更新" /></StackPanel>
                                                <PathIcon Grid.Column="2" VerticalAlignment="Center" Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="18">
                                <StackPanel Spacing="10">
                                    <StackPanel Margin="4,0,0,2" Spacing="3">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="客户端维护" />
                                        <TextBlock Classes="MiaomiaoMuted" Text="版本、核心与下载入口" />
                                    </StackPanel>
                                    <Border Classes="MiaomiaoSettingsGroup">
                                        <StackPanel Spacing="2">
                                            <Button x:Name="btnCoreUpdate" Classes="MiaomiaoSettingsRow"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="MiaomiaoSettingsIcon"><PathIcon Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M13,7V11H17V13H13V17H11V13H7V11H11V7H13Z" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="检查核心更新" /><TextBlock Classes="MiaomiaoMuted" Text="获取官方核心版本" TextWrapping="Wrap" /></StackPanel><PathIcon Grid.Column="2" VerticalAlignment="Center" Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z" /></Grid></Button>
                                            <Button x:Name="btnDownload" Classes="MiaomiaoSettingsRow"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="MiaomiaoSettingsIcon"><PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="下载中心" /><TextBlock Classes="MiaomiaoMuted" Text="客户端、帮助与版本说明" TextWrapping="Wrap" /></StackPanel><PathIcon Grid.Column="2" VerticalAlignment="Center" Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z" /></Grid></Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <StackPanel Margin="4,0,0,2" Spacing="3">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="本地数据" />
                                        <TextBlock Classes="MiaomiaoMuted" Text="配置备份与文件管理" />
                                    </StackPanel>
                                    <Border Classes="MiaomiaoSettingsGroup">
                                        <StackPanel Spacing="2">
                                            <Button x:Name="btnBackup" Classes="MiaomiaoSettingsRow"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="MiaomiaoSettingsIcon"><PathIcon Data="M17,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M12,19A3,3 0 1,1 12,13A3,3 0 0,1 12,19M6,5H15V9H6V5Z" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="备份与恢复" /><TextBlock Classes="MiaomiaoMuted" Text="导出或恢复本地配置" TextWrapping="Wrap" /></StackPanel><PathIcon Grid.Column="2" VerticalAlignment="Center" Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z" /></Grid></Button>
                                            <Button x:Name="btnOpenFolder" Classes="MiaomiaoSettingsRow"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="MiaomiaoSettingsIcon"><PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18C2,19.11 2.89,20 4,20H20C21.11,20 22,19.11 22,18V8C22,6.89 21.11,6 20,6H12L10,4Z" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="数据目录" /><TextBlock Classes="MiaomiaoMuted" Text="打开本地配置文件夹" TextWrapping="Wrap" /></StackPanel><PathIcon Grid.Column="2" VerticalAlignment="Center" Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z" /></Grid></Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Compatibility hosts keep upstream commands and view-model lifetimes intact without exposing the legacy workbench. -->
                <Grid IsVisible="False">
                    <MenuItem x:Name="menuOptionSetting" />
                    <MenuItem x:Name="menuRoutingSetting" />
                    <MenuItem x:Name="menuDNSSetting" />
                    <MenuItem x:Name="menuFullConfigTemplate" />
                    <MenuItem x:Name="menuGlobalHotkeySetting" />
                    <MenuItem x:Name="menuRebootAsAdmin" />
                    <MenuItem x:Name="menuClearServerStatistics" />
                    <MenuItem x:Name="menuRegionalPresetsDefault" />
                    <MenuItem x:Name="menuRegionalPresetsRussia" />
                    <MenuItem x:Name="menuRegionalPresetsIran" />
                    <MenuItem x:Name="menuBackupAndRestore" />
                    <MenuItem x:Name="menuOpenTheFileLocation" />
                    <ContentControl x:Name="contentStatusBarView" />
                    <Grid x:Name="gridMain" ColumnDefinitions="1*,8,1*">
                        <ContentControl x:Name="tabProfiles" />
                        <TabControl x:Name="tabMain"><TabItem x:Name="tabMsgView" /><TabItem x:Name="tabClashProxies" /><TabItem x:Name="tabClashConnections" /></TabControl>
                    </Grid>
                    <Grid x:Name="gridMain1" RowDefinitions="1*,8,1*">
                        <ContentControl x:Name="tabProfiles1" />
                        <TabControl x:Name="tabMain1"><TabItem x:Name="tabMsgView1" /><TabItem x:Name="tabClashProxies1" /><TabItem x:Name="tabClashConnections1" /></TabControl>
                    </Grid>
                    <Grid x:Name="gridMain2">
                        <TabControl x:Name="tabMain2"><TabItem x:Name="tabProfiles2" /><TabItem x:Name="tabMsgView2" /><TabItem x:Name="tabClashProxies2" /><TabItem x:Name="tabClashConnections2" /></TabControl>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Classes="MiaomiaoBottomBar">
                <Grid Margin="18,9" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <UniformGrid Width="690" Rows="1" Columns="5" HorizontalAlignment="Center">
