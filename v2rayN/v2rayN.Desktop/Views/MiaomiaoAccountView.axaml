<UserControl
    x:Class="v2rayN.Desktop.Views.MiaomiaoAccountView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:v2rayN.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:MiaomiaoAccountViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:MiaomiaoPlanPriceConverter x:Key="PlanPriceConverter" />
        <conv:MiaomiaoDateConverter x:Key="DateConverter" />
        <conv:MiaomiaoBytesConverter x:Key="BytesConverter" />
        <conv:MiaomiaoOrderPeriodConverter x:Key="OrderPeriodConverter" />
        <conv:MiaomiaoOrderAmountConverter x:Key="OrderAmountConverter" />
        <conv:MiaomiaoOrderStatusConverter x:Key="OrderStatusConverter" />
        <conv:MiaomiaoSpeedLimitConverter x:Key="SpeedLimitConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid IsVisible="{Binding !IsLoggedIn}">
            <Border
                Width="430"
                MaxHeight="520"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Classes="MiaomiaoCard">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="5">
                        <TextBlock Classes="MiaomiaoPageTitle" Text="登录喵喵" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="MiaomiaoMuted" Text="邮箱" />
                        <TextBox
                            Classes="MiaomiaoInput"
                            Text="{Binding Email, Mode=TwoWay}"
                            Watermark="name@example.com" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="MiaomiaoMuted" Text="密码" />
                        <TextBox
                            Classes="MiaomiaoInput"
                            PasswordChar="*"
                            Text="{Binding Password, Mode=TwoWay}" />
                    </StackPanel>
                    <Button
                        HorizontalContentAlignment="Center"
                        Classes="MiaomiaoPrimary"
                        Command="{Binding LoginCmd}"
                        Content="登录" />
                    <Button
                        HorizontalContentAlignment="Center"
                        Classes="MiaomiaoSecondary"
                        Command="{Binding OpenRegistrationCmd}"
                        Content="注册账户" />
                    <TextBlock
                        Foreground="{DynamicResource MiaomiaoWarningBrush}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />
                    <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsLoggedIn}" RowDefinitions="Auto,*" RowSpacing="16">
            <Border Grid.Row="0" Padding="18,16" Classes="MiaomiaoCard">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border
                        Width="42"
                        Height="42"
                        Background="{DynamicResource MiaomiaoPrimarySoftBrush}"
                        CornerRadius="8">
                        <PathIcon
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C7.58,14 4,15.79 4,18V20H20V18C20,15.79 16.42,14 12,14Z"
                            Foreground="{DynamicResource MiaomiaoPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding CurrentUser.Email}" />
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Classes="MiaomiaoMuted" Text="{Binding CurrentSubscription.Plan.Name, FallbackValue=未订阅, TargetNullValue=未订阅}" />
                            <TextBlock Classes="MiaomiaoMuted" Text="{Binding CurrentSubscription.ExpiredAt, Converter={StaticResource DateConverter}, StringFormat={}到期 {0}}" />
                            <TextBlock Classes="MiaomiaoMuted" Text="{Binding CurrentSubscription.TransferEnable, Converter={StaticResource BytesConverter}, StringFormat={}流量 {0}}" />
                            <TextBlock Classes="MiaomiaoMuted" Text="{Binding CurrentSubscription.DeviceLimit, FallbackValue=-, TargetNullValue=-, StringFormat={}设备 {0}}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button Classes="MiaomiaoSecondary" Command="{Binding RefreshCmd}" Content="刷新账户" />
                        <Button Classes="MiaomiaoSecondary" Command="{Binding LogoutCmd}" Content="退出" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="tabAccountSections" Grid.Row="1">
                <TabItem Header="套餐">
                    <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="18">
                            <StackPanel Grid.Row="0" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="MiaomiaoSectionTitle" Text="选择你的套餐" />
                                        <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="先选套餐，再查看完整权益和价格" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="MiaomiaoMuted" FontSize="12" Text="{Binding Plans.Count, StringFormat={}共 {0} 个套餐}" />
                                </Grid>
                                <ListBox
                                    Classes="MiaomiaoPlanGallery"
                                    ItemsSource="{Binding Plans}"
                                    SelectedItem="{Binding SelectedPlan, Mode=TwoWay}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:MiaomiaoPlan">
                                            <StackPanel Spacing="11">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <PathIcon
                                                        Grid.Column="1"
                                                        Width="17"
                                                        Height="17"
                                                        Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59Z"
                                                        Foreground="{DynamicResource MiaomiaoPrimaryBrush}" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="13">
                                                    <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="{Binding TransferEnable, StringFormat={}{0:0.##} GB}" />
                                                    <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="{Binding DeviceLimit, StringFormat={}设备 {0}}" />
                                                    <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="{Binding SpeedLimit, Converter={StaticResource SpeedLimitConverter}}" />
                                                </StackPanel>
                                                <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="{Binding ., Converter={StaticResource PlanPriceConverter}}" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource MiaomiaoPrimarySoftForegroundBrush}" Text="查看完整详情 →" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnDefinitions="*,390" ColumnSpacing="18">
                                <Border Grid.Column="0" Padding="24" Classes="MiaomiaoCard">
                                    <StackPanel Spacing="15">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="MiaomiaoSectionTitle" Text="套餐详情" />
                                                <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="{Binding SelectedPlan.Name, FallbackValue=请选择上方套餐, TargetNullValue=请选择上方套餐}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="10,6" Background="{DynamicResource MiaomiaoPrimarySoftBrush}" CornerRadius="8">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource MiaomiaoPrimarySoftForegroundBrush}" Text="完整权益" />
                                            </Border>
                                        </Grid>
                                        <Separator />
                                        <views:MiaomiaoRichTextView Source="{Binding SelectedPlan.Content}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Padding="22" Classes="MiaomiaoCard">
                                    <StackPanel Spacing="17">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="MiaomiaoSectionTitle" Text="结算" />
                                            <TextBlock Classes="MiaomiaoMuted" FontSize="12" Text="确认周期和优惠后创建订单" />
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="购买周期" />
                                            <ListBox
                                                Classes="MiaomiaoPeriodList"
                                                ItemsSource="{Binding BillingPeriods}"
                                                SelectedItem="{Binding SelectedBillingPeriod, Mode=TwoWay}">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:MiaomiaoBillingPeriod">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                                            <TextBlock FontSize="12" Text="{Binding PriceDisplay}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock FontWeight="SemiBold" Text="优惠码" />
                                                <TextBlock Grid.Column="1" Classes="MiaomiaoMuted" FontSize="11" Text="选填" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox Classes="MiaomiaoInput" Text="{Binding CouponCode, Mode=TwoWay}" Watermark="输入优惠码" />
                                                <Button Grid.Column="1" MinWidth="72" HorizontalContentAlignment="Center" Classes="MiaomiaoSecondary" Command="{Binding ValidateCouponCmd}" Content="应用" />
                                            </Grid>
                                            <TextBlock IsVisible="{Binding IsCouponApplied}" Foreground="{DynamicResource MiaomiaoSuccessBrush}" Text="{Binding CouponStatusMessage}" TextWrapping="Wrap" />
                                            <TextBlock IsVisible="{Binding IsCouponRejected}" Foreground="{DynamicResource MiaomiaoWarningBrush}" Text="{Binding CouponStatusMessage}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Separator />
                                        <StackPanel Spacing="9">
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="MiaomiaoMuted" Text="套餐价格" /><TextBlock Grid.Column="1" Text="{Binding OriginalPriceText}" /></Grid>
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="MiaomiaoMuted" Text="优惠减免" /><TextBlock Grid.Column="1" Foreground="{DynamicResource MiaomiaoSuccessBrush}" Text="{Binding CouponDiscountText}" /></Grid>
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="MiaomiaoMuted" Text="余额抵扣" /><TextBlock Grid.Column="1" Text="{Binding BalanceDeductionText}" /></Grid>
                                            <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="2"><TextBlock FontWeight="SemiBold" Text="应付金额" /><TextBlock Classes="MiaomiaoMuted" FontSize="11" Text="{Binding BalanceText, StringFormat={}账户余额 {0}}" /></StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource MiaomiaoPrimaryBrush}" Text="{Binding PayableAmountText}" />
                                            </Grid>
                                        </StackPanel>
                                        <Button MinHeight="46" HorizontalContentAlignment="Center" Classes="MiaomiaoPrimary" Command="{Binding PurchaseCmd}" Content="确认购买" />
                                        <Border Padding="14" Classes="MiaomiaoAccentCard" IsVisible="{Binding HasPendingOrder}">
                                            <StackPanel Spacing="10">
                                                <TextBlock FontWeight="SemiBold" Text="完成支付" />
                                                <ComboBox DisplayMemberBinding="{Binding Name}" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}" />
                                                <Button HorizontalContentAlignment="Center" Classes="MiaomiaoPrimary" Command="{Binding PayCmd}" Content="前往支付" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Classes="MiaomiaoSecondary" Command="{Binding OpenPaymentCmd}" Content="支付页" />
                                                    <Button Classes="MiaomiaoSecondary" Command="{Binding CheckPaymentCmd}" Content="查询" />
                                                    <Button Classes="MiaomiaoSecondary" Command="{Binding CancelPaymentCmd}" Content="取消" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="MiaomiaoMuted" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource MiaomiaoWarningBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                                        <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="订单">
                    <Border Margin="0,14,0,0" Padding="10" Classes="MiaomiaoCard">
                        <DataGrid
                            AutoGenerateColumns="False"
                            GridLinesVisibility="Horizontal"
                            IsReadOnly="True"
                            ItemsSource="{Binding Orders}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="2*" Binding="{Binding TradeNo}" Header="订单号" />
                                <DataGridTextColumn Width="*" Binding="{Binding Plan.Name}" Header="套餐" />
                                <DataGridTextColumn Width="*" Binding="{Binding Period, Converter={StaticResource OrderPeriodConverter}}" Header="周期" />
                                <DataGridTextColumn Width="*" Binding="{Binding TotalAmount, Converter={StaticResource OrderAmountConverter}}" Header="实付金额" />
                                <DataGridTextColumn Width="*" Binding="{Binding Status, Converter={StaticResource OrderStatusConverter}}" Header="状态" />
                                <DataGridTextColumn Width="1.2*" Binding="{Binding CreatedAt, Converter={StaticResource DateConverter}}" Header="创建时间" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
