<UserControl
    x:Class="v2rayN.Desktop.Views.MiaomiaoNoticeDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views">
    <Border
        Width="560"
        MaxHeight="620"
        Padding="24"
        Background="{DynamicResource MiaomiaoSurfaceBrush}"
        BorderBrush="{DynamicResource MiaomiaoBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock x:Name="txtTitle" Classes="MiaomiaoPageTitle" TextWrapping="Wrap" />
                <TextBlock x:Name="txtDate" Classes="MiaomiaoMuted" FontSize="11" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" MaxHeight="430" VerticalScrollBarVisibility="Auto">
                <views:MiaomiaoRichTextView x:Name="richContent" />
            </ScrollViewer>
            <Button
                x:Name="btnClose"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Classes="MiaomiaoPrimary"
                Content="我知道了" />
        </Grid>
    </Border>
</UserControl>
